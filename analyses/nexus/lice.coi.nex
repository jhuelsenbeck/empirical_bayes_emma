#NEXUS

begin data;
   dimensions ntax=10 nchar=379;
   format datatype=dna;
   matrix
   G_setzeri       
   G_cherriei      
   G_panamensis    
   G_costaricensis 
   G_chapini       
   G_thomomyus     
   T_barbarae      
   G_actuosi       
   T_minor         
