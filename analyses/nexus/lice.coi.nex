#NEXUS

[
@article{Hafner1994,
  author  = {Hafner, Mark S. and Sudman, Philip D. and Villablanca, Francis X.
             and Spradling, Theresa A. and Demastes, James W.
             and Nadler, Steven A.},
  title   = {Disparate Rates of Molecular Evolution in Cospeciating Hosts
             and Parasites},
  journal = {Science},
  year    = {1994},
  volume  = {265},
  number  = {5175},
  pages   = {1087--1090},
  doi     = {10.1126/science.8066445}
}
]

begin data;
   dimensions ntax=10 nchar=379;
   format datatype=dna;
   matrix
   G_setzeri       
   G_cherriei      
   G_panamensis    
   G_costaricensis 
   G_chapini       
   G_thomomyus     
   T_barbarae      
   G_actuosi       
   T_minor         
   G_expansus      
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
