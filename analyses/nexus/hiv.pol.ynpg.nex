#NEXUS

[
@article{Yang2000,
  author  = {Yang, Ziheng and Nielsen, Rasmus and Goldman, Nick
             and Pedersen, Anne-Mette Krabbe},
  title   = {Codon-Substitution Models for Heterogeneous Selection Pressure
             at Amino Acid Sites},
  journal = {Genetics},
  year    = {2000},
  volume  = {155},
  number  = {1},
  pages   = {431--449},
  doi     = {10.1093/genetics/155.1.431}
}
]

begin data;
   dimensions ntax=10 nchar=2841;
   format datatype=dna;
   matrix
   B_SF2   
   B_LAI   
   B_NL43  
   B_NY5   
   B_LW123 
   B_MN    
   B_JRCSF 
   B_JRFL  
   B_OYI   
   B_CAM1  
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
