begin data;
   dimensions ntax=10 nchar=333;
   format datatype=dna;
   matrix
   L35388t 
   L35392s 
   L35393t 
   L35402t 
   L35405t 
   L35437s 
   L35401t 
   L35397t 
   L35382t 
   L35431v 
