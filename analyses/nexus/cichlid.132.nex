#NEXUS

[
@article{Farias1999,
  author  = {Farias, Izeni P. and Ort{\'i}, Guillermo and Sampaio, Iracilda
             and Schneider, Horacio and Meyer, Axel},
  title   = {Mitochondrial {DNA} Phylogeny of the Family {Cichlidae}:
             Monophyly and Fast Molecular Evolution of the Neotropical
             Assemblage},
  journal = {Journal of Molecular Evolution},
  year    = {1999},
  volume  = {48},
  number  = {6},
  pages   = {703--711},
  doi     = {10.1007/PL00006514}
}
]

begin data;
   dimensions ntax=10 nchar=1047;
   format datatype=dna;
   matrix
   Astronotus  
   Cichla      
   Crenicichla 
   L_brichardi 
   Cichlasoma  
   Pseudotrop  
   C_spilorhy  
   B_lepturus  
   Le_auritus  
   Cyphotilap  
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
