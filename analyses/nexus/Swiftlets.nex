#NEXUS

begin data;
   dimensions ntax=10 nchar=406;
   format datatype=dna;
   matrix
   Cypsiurus_balasiensis           
   Collocalia_esculenta_linchi     
   Collocalia_troglodytes          
   Collocalia_esculenta_cyanoptila 
   Collocalia_esculenta_bagobo     
   Collocalia_marginata            
   Chaetura_vauxi                  
   Apus_apus                       
   Aerodramus_terraereginae        
   Aerodramus_maximus              
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
