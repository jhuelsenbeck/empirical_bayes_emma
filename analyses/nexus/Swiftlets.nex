#NEXUS

[
@article{Page1998,
  author  = {Page, Roderic D. M. and Lee, Patricia L. M. and Becher, Sabine A.
             and Griffiths, Richard and Clayton, Dale H.},
  title   = {A Different Tempo of Mitochondrial {DNA} Evolution in Birds
             and Their Parasitic Lice},
  journal = {Molecular Phylogenetics and Evolution},
  year    = {1998},
  volume  = {9},
  number  = {2},
  pages   = {276--293}
}
]

begin data;
   dimensions ntax=10 nchar=406;
   format datatype=dna;
   matrix
   Cypsiurus_balasiensis           
   Collocalia_esculenta_linchi     
   Collocalia_troglodytes          
   Collocalia_esculenta_cyanoptila 
   Collocalia_esculenta_bagobo     
   Collocalia_marginata            
   Chaetura_vauxi                  
   Apus_apus                       
   Aerodramus_terraereginae        
   Aerodramus_maximus              
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
