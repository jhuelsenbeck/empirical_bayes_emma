#NEXUS

[
@article{Frati1997,
  author  = {Frati, Francesco and Simon, Chris and Sullivan, Jack
             and Swofford, David L.},
  title   = {Evolution of the Mitochondrial Cytochrome Oxidase {II} Gene
             in {Collembola}},
  journal = {Journal of Molecular Evolution},
  year    = {1997},
  volume  = {44},
  number  = {2},
  pages   = {145--158},
  doi     = {10.1007/PL00006131}
}
]

begin data;
   dimensions ntax=10 nchar=456;
   format datatype=dna;
   matrix
   Ovi-SIE 
   Ovi-AMI 
   Ora-GIG 
   Ofl-CAN 
   Oci-BSR 
   Oda-MAR 
   Iun-SIE 
   Iun-RAD 
   Ima-SIE 
   Ipa-GER 
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
