#NEXUS

begin data;
   dimensions ntax=10 nchar=1255;
   format datatype=dna;
   matrix
   Homo              
   Tarsius           
   Galago            
   Cynocephalus      
   Tupaia            
   Pteropus          
   Tonatia_bidens    
   Tonatia_silvicola 
   Felis             
   Bos               
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
