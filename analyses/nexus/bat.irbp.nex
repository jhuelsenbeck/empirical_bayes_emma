#NEXUS

[
@article{Stanhope1992,
  author  = {Stanhope, Michael J. and Czelusniak, John and Si, Jing-Sheng
             and Nickerson, John and Goodman, Morris},
  title   = {A Molecular Perspective on Mammalian Evolution from the Gene
             Encoding Interphotoreceptor Retinoid Binding Protein, with
             Convincing Evidence for Bat Monophyly},
  journal = {Molecular Phylogenetics and Evolution},
  year    = {1992},
  volume  = {1},
  number  = {2},
  pages   = {148--160},
  doi     = {10.1016/1055-7903(92)90026-D}
}

@article{VanDenBussche1998,
  author  = {Van Den Bussche, Ronald A. and Baker, Robert J.
             and Huelsenbeck, John P. and Hillis, David M.},
  title   = {Base Compositional Bias and Phylogenetic Analyses:
             A Test of the ``Flying {DNA}'' Hypothesis},
  journal = {Molecular Phylogenetics and Evolution},
  year    = {1998},
  volume  = {10},
  number  = {3},
  pages   = {408--416},
  doi     = {10.1006/mpev.1998.0531}
}
]

begin data;
   dimensions ntax=10 nchar=1255;
   format datatype=dna;
   matrix
   Homo              
   Tarsius           
   Galago            
   Cynocephalus      
   Tupaia            
   Pteropus          
   Tonatia_bidens    
   Tonatia_silvicola 
   Felis             
   Bos               
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
