#NEXUS

begin data;
   dimensions ntax=5 nchar=895;
   format datatype=dna;
   matrix
   Human      
   Chimpanzee 
   Gorilla    
   Orangutan  
   Gibbon     
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
