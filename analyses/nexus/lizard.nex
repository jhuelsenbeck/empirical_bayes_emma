#NEXUS

begin data;
   dimensions ntax=10 nchar=1456;
   format datatype=dna;
   matrix
   Diplolaemus_darwinii   
   Polychrus_acutirostris 
   Anolis_acutus          
   Anolis_cristatellus    
   Anolis_krugi           
   Anolis_stratulus       
   Anolis_bimaculatus     
   Anolis_wattsi          
   Anolis_bahorucoensis   
   Anolis_insolitus       
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
