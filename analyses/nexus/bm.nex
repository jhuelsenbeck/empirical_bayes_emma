#NEXUS

[
@article{Hayasaka1988,
  author  = {Hayasaka, Kenji and Gojobori, Takashi and Horai, Satoshi},
  title   = {Molecular Phylogeny and Evolution of Primate Mitochondrial {DNA}},
  journal = {Molecular Biology and Evolution},
  year    = {1988},
  volume  = {5},
  number  = {6},
  pages   = {626--644},
  doi     = {10.1093/oxfordjournals.molbev.a040524}
}
]

begin data;
   dimensions ntax=10 nchar=898;
   format datatype=dna;
   matrix
   Homo_sapiens        
   Pan                 
   Gorilla             
   Pongo               
   Hylobates           
   Macaca_fuscata      
   Macaca_mulatta      
   Macaca_fascicularis 
   Macaca_sylvanus     
   Saimiri_sciureus    
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
