#NEXUS

[
@article{Jackman1999,
  author  = {Jackman, Todd R. and Larson, Allan and de Queiroz, Kevin
             and Losos, Jonathan B.},
  title   = {Phylogenetic Relationships and Tempo of Early Diversification
             in {Anolis} Lizards},
  journal = {Systematic Biology},
  year    = {1999},
  volume  = {48},
  number  = {2},
  pages   = {254--285}
}]

begin data;
   dimensions ntax=10 nchar=1456;
   format datatype=dna;
   matrix
   Anolis_ahli          
   Anolis_aliniger      
   Anolis_alutaceus     
   Anolis_angusticeps   
   Anolis_bahorucoensis 
   Anolis_barahonae     
   Anolis_brevirostris  
   Anolis_coelestinus   
   Anolis_cristatellus  
   Anolis_cuvieri       
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
