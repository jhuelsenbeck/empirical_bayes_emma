#NEXUS

begin data;
   dimensions ntax=4 nchar=59;
   format datatype=dna;
   matrix
   Sceloporus CAAAAAGTAGCTTAAATAAAGCATTCAACTTACAATTGAAAAATGTTAAACCTATTTGA
   Alligator  CAAAATGTAGCTTAAATAAAGCATTCAGTTTACACCTGAAAAATGCCCGACCATTTTGA
   Gallus     CAAGGCGTAGCTATAACAAAGCATTCAGCTTACACCTGAAAGATACCCGGTCGCCTTGA
   Mus        CATAGTGTAGCTTAATTAAAGCATCTGGCCTACACCCAGAAGATTTCAGAACACTCTGA
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
