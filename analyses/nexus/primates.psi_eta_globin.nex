#NEXUS

[
@article{Miyamoto1987,
  author  = {Miyamoto, Michael M. and Slightom, Jerry L. and Goodman, Morris},
  title   = {Phylogenetic Relations of Humans and {African} Apes from {DNA}
             Sequences in the $\psi\eta$-Globin Region},
  journal = {Science},
  year    = {1987},
  volume  = {238},
  number  = {4825},
  pages   = {369--373},
  doi     = {10.1126/science.3116671}
}
]

begin data;
   dimensions ntax=6 nchar=2197;
   format datatype=dna;
   matrix
   human       
   chimpanzee  
   pygmy_chimp 
   gorilla     
   orangutan   
   rhesus      
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
