#NEXUS

begin data;
   dimensions ntax=6 nchar=2197;
   format datatype=dna;
   matrix
   human       
   chimpanzee  
   pygmy_chimp 
   gorilla     
   orangutan   
   rhesus      
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
