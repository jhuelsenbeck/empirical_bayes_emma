#NEXUS

begin data;
   dimensions ntax=10 nchar=924;
   format datatype=dna;
   matrix
   Am_inornatus     
   Am_anoikos       
   Am_macgregoriae  
   Am_subalaris     
   Ar_papuensis     
   C_cerviniventris 
   C_gutatta        
