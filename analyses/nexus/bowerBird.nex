#NEXUS

[
@article{Kusmierski1997,
  author  = {Kusmierski, Roman and Borgia, Gerald and Uy, Albert
             and Crozier, Ross H.},
  title   = {Labile Evolution of Display Traits in Bowerbirds Indicates
             Reduced Effects of Phylogenetic Constraint},
  journal = {Proceedings of the Royal Society of London B},
  year    = {1997},
  volume  = {264},
  number  = {1380},
  pages   = {307--313},
  doi     = {10.1098/rspb.1997.0044}
}
]

begin data;
   dimensions ntax=10 nchar=924;
   format datatype=dna;
   matrix
   Am_inornatus     
   Am_anoikos       
   Am_macgregoriae  
   Am_subalaris     
   Ar_papuensis     
   C_cerviniventris 
   C_gutatta        
   C_lauterbachii   
   C_maculata       
   C_nuchalis       
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
