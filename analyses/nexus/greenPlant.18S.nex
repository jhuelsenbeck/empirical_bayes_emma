#NEXUS

[
@article{Soltis1999,
  author  = {Soltis, Pamela S. and Soltis, Douglas E. and Wolf, Paul G.
             and Nickrent, Daniel L. and Chaw, Shu-Miaw
             and Chapman, Russell L.},
  title   = {The Phylogeny of Land Plants Inferred from 18{S} {rDNA}
             Sequences: Pushing the Limits of {rDNA} Signal?},
  journal = {Molecular Biology and Evolution},
  year    = {1999},
  volume  = {16},
  number  = {12},
  pages   = {1774--1784},
  doi     = {10.1093/oxfordjournals.molbev.a026089}
}
]

begin data;
   dimensions ntax=10 nchar=1850;
   format datatype=dna;
   matrix
   Ephedra_sinica        
   Ephedra_torreyana     
   Gnetum_gnemon         
   Gnetum_nodiflorum     
   Gnetum_urens          
   Zamia_pumila          
   Sagittaria_trifoliata 
   Allium_thunbergii     
   Hippeastrum_sp.       
   Eucharis_grandiflora  
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
