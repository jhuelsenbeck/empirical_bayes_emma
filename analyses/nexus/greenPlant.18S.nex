#NEXUS

begin data;
   dimensions ntax=10 nchar=1850;
   format datatype=dna;
   matrix
   Ephedra_sinica        
   Ephedra_torreyana     
   Gnetum_gnemon         
   Gnetum_nodiflorum     
   Gnetum_urens          
   Zamia_pumila          
   Sagittaria_trifoliata 
   Allium_thunbergii     
   Hippeastrum_sp.       
   Eucharis_grandiflora  
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
