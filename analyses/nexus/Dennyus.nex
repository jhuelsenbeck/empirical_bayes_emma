#NEXUS

[
@article{Page1998,
  author  = {Page, Roderic D. M. and Lee, Patricia L. M. and Becher, Sabine A.
             and Griffiths, Richard and Clayton, Dale H.},
  title   = {A Different Tempo of Mitochondrial {DNA} Evolution in Birds
             and Their Parasitic Lice},
  journal = {Molecular Phylogenetics and Evolution},
  year    = {1998},
  volume  = {9},
  number  = {2},
  pages   = {276--293}
}
]

begin data;
   dimensions ntax=10 nchar=505;
   format datatype=dna;
   matrix
   Dennyus_distinctus_timjonesi_1 
   Dennyus_distinctus_timjonesi_2 
   Dennyus_distinctus_distinctus  
   Dennyus_somadikartai__U96418   
   Dennyus_somadikartai_U96419    
   Dennyus_carljonesi_carljonesi  
   Dennyus_carljonesi_fosteri     
   Dennyus_carljonesi_forresteri  
   Dennyus_singhi                 
   Dennyus_thompsoni_U96424       
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
