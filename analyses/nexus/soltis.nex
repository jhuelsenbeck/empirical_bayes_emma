#NEXUS

begin data;
   dimensions ntax=10 nchar=4811;
   format datatype=dna;
   matrix
   Thunbergia_coccinea     
   Acorus_calamus          
   Actinidia_chinensis     
   Sambucus_nigra          
   Viburnum_opulus         
   Aextoxicon_punctatum    
   Delosperma_echinatum    
   Bomarea_hirtella        
   Altingia_excelsa        
   Liquidambar_styraciflua 
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
