#NEXUS

[
@article{DErchia1996,
  author  = {D'Erchia, Anna Maria and Gissi, Carmela and Pesole, Graziano
             and Saccone, Cecilia and Arnason, Ulfur},
  title   = {The Guinea-Pig Is Not a Rodent},
  journal = {Nature},
  year    = {1996},
  volume  = {381},
  number  = {6583},
  pages   = {597--600},
  doi     = {10.1038/381597a0}
}
]

begin data;
   dimensions ntax=10 nchar=9741;
   format datatype=dna;
   matrix
   Ornithorhynchus_anatinus 
   Didelphis_virginiana     
   Macropus_robustus        
   Dasypus_novemcinctus     
   Rattus_norvegicus        
   Mus_musculus             
   Oryctolagus_cuniculus    
   Cavia_porcellus          
   Erinaceus_europaeus      
   Felis_domesticus         
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
