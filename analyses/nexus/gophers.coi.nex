#NEXUS

begin data;
   dimensions ntax=10 nchar=379;
   format datatype=dna;
   matrix
   T_talpoides  
   T_bottae     
   O_underwoodi 
   O_hispidus   
   O_cavator    
   O_cherriei   
   O_heterodus  
   G_breviceps  
   G_personatus 
   G_bur_majus  
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
