#NEXUS

begin data;
   dimensions ntax=10 nchar=1428;
   format datatype=dna;
   matrix
   Nicotiana  
   Acer       
   Acorus     
   Actinidia  
   Adansonia  
   Adinandra  
   Aesculus   
   Aextoxicon 
   Afrostyrax 
   Ailanthus  
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
