#NEXUS

begin data;
   dimensions ntax=10 nchar=825;
   format datatype=dna;
   matrix
   Collybia_polyphylla    
   Collybia_dryophila     
   Rhodocollybia_maculata 
   Lentinula_edodes       
   Marasmiellus_ramealis  
   Micromphale_perforans  
   Nothopanus_eugrammus   
   Omphalotus_nidiformis  
   Crinipellis_maxima     
   Marasmius_capillaris   
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
