#NEXUS

[
@article{Moncalvo2000,
  author  = {Moncalvo, Jean-Marc and Lutzoni, Fran{\c{c}}ois M.
             and Rehner, Stephen A. and Johnson, Jacqui and Vilgalys, Rytas},
  title   = {Phylogenetic Relationships of Agaric Fungi Based on Nuclear
             Large Subunit Ribosomal {DNA} Sequences},
  journal = {Systematic Biology},
  year    = {2000},
  volume  = {49},
  number  = {2},
  pages   = {278--305},
  doi     = {10.1093/sysbio/49.2.278}
}
]

begin data;
   dimensions ntax=10 nchar=825;
   format datatype=dna;
   matrix
   Collybia_polyphylla    
   Collybia_dryophila     
   Rhodocollybia_maculata 
   Lentinula_edodes       
   Marasmiellus_ramealis  
   Micromphale_perforans  
   Nothopanus_eugrammus   
   Omphalotus_nidiformis  
   Crinipellis_maxima     
   Marasmius_capillaris   
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
