#NEXUS

begin data;
   dimensions ntax=10 nchar=686;
   format datatype=dna;
   matrix
   Astragalus_paposanus           
   Astragalus_neuquenensis        
   Astragalus_arnottianus         
   Astragalus_pehuenches          
   Astragalus_patagonicus         
   Astragalus_palenae_var_grandif 
   Astragalus_palenae_var_palenae 
   Astragalus_moyanoi             
   Astragalus_unident             
   Astragalus_pickeringii         
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
