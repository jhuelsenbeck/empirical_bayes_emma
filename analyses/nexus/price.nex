#NEXUS

[
@article{Price2000,
  author  = {Price, Trevor and Lovette, Irby J. and Bermingham, Eldredge
             and Gibbs, H. Lisle and Richman, Adam D.},
  title   = {The Imprint of History on Communities of {North American}
             and {Asian} Warblers},
  journal = {The American Naturalist},
  year    = {2000},
  volume  = {156},
  number  = {4},
  pages   = {354--367},
  doi     = {10.1086/303397}
}
]

begin data;
   dimensions ntax=10 nchar=1153;
   format datatype=dna;
   matrix
   LDeca  
   LDeco  
   LDema  
   LDest  
   LDevi  
   LSeru  
   LVeru  
   LWica  
   LDecae 
   LDepeN 
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
