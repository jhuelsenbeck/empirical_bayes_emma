#NEXUS

[
@article{Whiting1997,
  author  = {Whiting, Michael F. and Carpenter, James C.
             and Wheeler, Quentin D. and Wheeler, Ward C.},
  title   = {The {Strepsiptera} Problem: Phylogeny of the Holometabolous
             Insect Orders Inferred from 18{S} and 28{S} Ribosomal {DNA}
             Sequences and Morphology},
  journal = {Systematic Biology},
  year    = {1997},
  volume  = {46},
  number  = {1},
  pages   = {1--68},
  doi     = {10.1093/sysbio/46.1.1}
}
]

begin data;
   dimensions ntax=10 nchar=902;
   format datatype=dna;
   matrix
   Collembola    
   Archaeognatha 
   Ephemerida    
   Odonata_1     
   Odonata_2     
   Plecoptera_1  
   Plecoptera_2  
   Blattodea     
   Mantodea      
   Dermaptera    
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
