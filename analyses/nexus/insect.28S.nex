#NEXUS

begin data;
   dimensions ntax=10 nchar=358;
   format datatype=dna;
   matrix
   Archaeognatha 
   Ephemerida    
   Odonata_1     
   Odonata_2     
   Plecoptera_1  
   Plecoptera_2  
   Mantodea      
   Orthoptera    
