#NEXUS

[
@article{Sullivan1997b,
  author  = {Sullivan, Jack and Markert, Jeffrey A. and Kilpatrick, C. William},
  title   = {Molecular Systematics and Phylogeography of the
             {Peromyscus} {aztecus} Species Group ({Rodentia}: {Muridae})
             Inferred Using Parsimony and Likelihood},
  journal = {Systematic Biology},
  year    = {1997},
  volume  = {46},
  number  = {3},
  pages   = {426--440},
  doi     = {10.1093/sysbio/46.3.426}
}
]

begin data;
   dimensions ntax=10 nchar=667;
   format datatype=dna;
   matrix
   P.boylii_1965        
   P.a.aztecus_2204     
   P.a.aztecus_235      
   P.a.aztecus_4053     
   P.a.evides_3407      
   P.a.evides_3439      
   P.a.oaxacensis_34194 
   P.a.oaxacensis_3516  
   P.a.oaxacensis_2117  
   P.hylocetes_2040     
   ;
end;

begin mrbayes;
   lset nst=1 rates=equal;
   prset statefreqpr=fixed(0.25,0.25,0.25,0.25);
   mcmc nruns=1 nchains=1 ngen=1000000;
   sumt;
end;
